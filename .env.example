# ------------------------------------------------------------
# PostgreSQL database
# ------------------------------------------------------------
# Before starting Smart Wardrobe:
# 1. Start PostgreSQL.
# 2. Create a database named "wardrobe".
# 3. Replace YOUR_PASSWORD with the password of your local
#    PostgreSQL user.
#
# Format:
# postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
#
# Default local example:
# USERNAME = postgres
# HOST     = localhost
# PORT     = 5432
# DATABASE = wardrobe
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wardrobe


# ------------------------------------------------------------
# Browser session
# ------------------------------------------------------------
# Generate a secure value with:
# openssl rand -hex 32
SESSION_SECRET=PASTE_YOUR_GENERATED_SESSION_SECRET_HERE


# ------------------------------------------------------------
# Gemini provider
# ------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536


# ------------------------------------------------------------
# OpenAI provider
# ------------------------------------------------------------
# Optional when Smart Wardrobe is used only with Gemini.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_IF_USED